#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Equipment"
    {
        def Cube "Part"
        {
            color3f[] primvars:displayColor = [(0.3, 0.5, 0.7)]
            double size = 2
            float3 xformOp:scale = (1, 0.5, 0.1)
            double3 xformOp:translate = (3, 2, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}

