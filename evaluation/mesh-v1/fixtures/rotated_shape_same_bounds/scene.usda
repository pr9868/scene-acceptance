#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Equipment"
    {
        def Mesh "Part"
        {
            int[] faceVertexCounts = [4, 3, 3, 3, 3]
            int[] faceVertexIndices = [3, 2, 1, 0, 0, 1, 4, 1, 2, 4, 2, 3, 4, 3, 0, 4]
            point3f[] points = [(-1, -0.5, -0.1), (1, -0.5, -0.1), (1, 0.5, -0.1), (-1, 0.5, -0.1), (0.4, 0.1, 0.1)]
            color3f[] primvars:displayColor = [(0.3, 0.5, 0.7)]
            uniform token subdivisionScheme = "none"
            float xformOp:rotateZ = 180
            double3 xformOp:translate = (3, 2, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }
    }
}

