#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Equipment"
    {
        def Mesh "Part"
        {
            int[] faceVertexCounts = [5]
            int[] faceVertexIndices = [0, 1, 2, 3, 4]
            point3f[] points = [(-1, -0.5, 0), (1, -0.5, 0), (1, 0.5, 0), (0, 0, 0), (-1, 0.5, 0)]
            color3f[] primvars:displayColor = [(0.3, 0.5, 0.7)]
            uniform token subdivisionScheme = "none"
            double3 xformOp:translate = (3, 2, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

