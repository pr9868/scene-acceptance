#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Equipment"
    {
        def Mesh "Part"
        {
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [3, 2, 1, 0, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
            point3f[] points = [(-1, -0.5, -0.1), (1, -0.5, -0.1), (1, 0.5, -0.1), (-1, 0.5, -0.1), (-1, -0.5, 0.1), (1, -0.5, 0.1), (1, 0.5, 0.1), (-1, 0.5, 0.1)]
            color3f[] primvars:displayColor = [(0.3, 0.5, 0.7)]
            uniform token subdivisionScheme = "none"
            double3 xformOp:translate = (3, 2, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

