#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Equipment"
    {
        def Xform "Inspection"
        {
            def Cube "Body"
            {
                color3f[] primvars:displayColor = [(0.25, 0.48, 0.58)]
                double size = 1
                double3 xformOp:scale = (1, 0.8, 1.4)
                double3 xformOp:translate = (2.3, 3, 0.7)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Xform "Outfeed"
        {
            def Cube "Body"
            {
                color3f[] primvars:displayColor = [(0.5, 0.56, 0.6)]
                double size = 1
                double3 xformOp:scale = (2, 0.75, 0.9)
                double3 xformOp:translate = (4.5, 3.5, 0.45)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Xform "Tray"
        {
            def Cube "Deck"
            {
                color3f[] primvars:displayColor = [(0.67, 0.38, 0.18)]
                double size = 1
                double3 xformOp:scale = (1.4, 1.1, 0.16)
                double3 xformOp:translate = (6.1, 3.4, 0.08)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }
    }
