{
  "schema_version": "2.0",
  "id": "fresh-motion",
  "intended_use": "Selected production requirements from the frozen brief; broader review is separate",
  "profile": {
    "id": "fresh-producer-v1",
    "version": "1.0.0"
  },
  "artifact_format": "usd-local-v1",
  "allowed_dependencies": [],
  "evidence_sources": [],
  "packs": {
    "openusd": {
      "version": "1.0.0"
    },
    "motion.timing": {
      "version": "1.0.0"
    },
    "motion.connection": {
