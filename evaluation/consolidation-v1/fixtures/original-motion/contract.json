      "id": "format",
      "pack": "openusd",
      "check": "validators",
      "required": true,
      "parameters": {
        "validators": [
          "usdValidation:CompositionErrorTest",
          "usdValidation:StageMetadataChecker",
          "usdGeomValidators:StageMetadataChecker"
        ],
        "warnings_as_failures": false
      }
    },
    {
      "id": "clock",
      "pack": "motion.timing",
      "check": "clock",
      "required": true,
      "parameters": {
        "duration_s": 3,
        "tolerance_s": 1e-09,
        "time_codes_per_second": 48
      }
    },
    {
      "id": "connection.crank",
      "pack": "motion.connection",
      "check": "distance",
      "required": true,
      "parameters": {
        "a": {
          "path": "/World/Mechanism/Rod",
          "local_point": [
            0,
            0,
            0
          ]
        },
        "b": {
          "path": "/World/Mechanism/Crank/Pin",
          "local_point": [
            0,
            0,
            0
          ]
        },
        "interval_s": [
          0,
          3
        ],
        "segments": 256,
        "schedule": "keys-and-midpoints",
        "max_gap_m": 0.0005
      }
    },
    {
      "id": "connection.slider",
