      "pack": "fresh.brief",
      "check": "common.metadata",
      "required": true,
      "parameters": {
        "job": "tray-baseline"
      }
    },
    {
      "id": "brief.common.geometry",
      "pack": "fresh.brief",
      "check": "common.geometry",
      "required": true,
      "parameters": {
        "job": "tray-baseline"
      }
