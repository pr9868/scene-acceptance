      "pack": "fresh.brief",
      "check": "tray.dimensions",
      "required": true,
      "parameters": {
        "job": "tray-baseline"
      }
    },
    {
      "id": "brief.tray.cavity",
      "pack": "fresh.brief",
      "check": "tray.cavity",
      "required": true,
      "parameters": {
        "job": "tray-baseline"
      }
    },
    {
      "id": "brief.tray.closure",
      "pack": "fresh.brief",
      "check": "tray.closure",
      "required": true,
