          "usdValidation:CompositionErrorTest",
          "usdValidation:StageMetadataChecker",
          "usdGeomValidators:StageMetadataChecker"
        ],
        "warnings_as_failures": false
      }
    },
    {
      "id": "geometry",
      "pack": "geometry",
      "check": "contract",
      "required": true,
      "parameters": {
