      "pack": "fresh.brief",
      "check": "tray.transform",
      "required": true,
      "parameters": {
        "job": "tray-baseline"
      }
    },
    {
      "id": "brief.tray.fixture",
      "pack": "fresh.brief",
      "check": "tray.fixture",
      "required": true,
      "parameters": {
        "job": "tray-baseline"
      }
    }
  ]
