{
  "schema_version": "2.0",
  "id": "fresh-tray-baseline",
  "intended_use": "Selected production requirements from the frozen brief; broader review is separate",
  "profile": {
    "id": "fresh-producer-v1",
    "version": "1.0.0"
  },
  "artifact_format": "usd-local-v1",
  "allowed_dependencies": [],
  "evidence_sources": [
    "geometry.json"
  ],
  "packs": {
    "openusd": {
      "version": "1.0.0"
    },
    "geometry": {
      "version": "1.0.0"
    },
    "fresh.brief": {
      "version": "1.0.0",
