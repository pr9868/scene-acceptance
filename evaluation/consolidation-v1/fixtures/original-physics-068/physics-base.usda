#usda 1.0
(
    defaultPrim = "World"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "Physics"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Material "Contact" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
        customData = {
            string evidence = "assumed: no measurement supplied"
        }
    )
    {
        float physics:dynamicFriction = 0.65
        float physics:restitution = 0
        float physics:staticFriction = 0.65
    }

    def Cube "Ramp" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </World/Contact>
        double size = 1
        float xformOp:rotateY = 20
        float3 xformOp:scale = (20, 2, 0.2)
        double3 xformOp:translate = (-0.03420201433256687, -0, -0.09396926207859085)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:scale"]
    }

    def Cube "Block" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        rel material:binding:physics = </World/Contact>
        float physics:mass = 1
        double size = 1
        float xformOp:rotateY = 20
        float3 xformOp:scale = (0.2, 0.2, 0.1)
        double3 xformOp:translate = (0.017135209180616003, 0, 0.047078600301374014)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:scale"]
    }
}

