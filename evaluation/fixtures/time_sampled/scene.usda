#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Equipment"
    {
        def Xform "Pallet"
        {
            def Cube "Deck"
            {
                color3f[] primvars:displayColor = [(0.4, 0.5, 0.6)]
                double size = 1
                float3 xformOp:scale = (1.2, 1, 0.2)
                double3 xformOp:translate = (3, 1.75, 0.1)
                double3 xformOp:translate.timeSamples = {
                    1: (3, 1, 0.1),
                }
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Xform "Fixed"
        {
            def Cube "Block"
            {
                color3f[] primvars:displayColor = [(0.4, 0.5, 0.6)]
                double size = 1
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (6, 3, 0.5)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }
    }
}

