#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Equipment"
    {
        def Xform "Pallet"
        {
            def Cube "Deck"
            {
                color3f[] primvars:displayColor = [(0.4, 0.5, 0.6)]
                double size = 1
                float3 xformOp:scale = (120, 100, 20)
                double3 xformOp:translate = (300, 175, 10)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Xform "Fixed"
        {
            def Cube "Block"
            {
                color3f[] primvars:displayColor = [(0.4, 0.5, 0.6)]
                double size = 1
                float3 xformOp:scale = (100, 100, 100)
                double3 xformOp:translate = (600, 300, 50)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }
    }
}

