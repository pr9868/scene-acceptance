{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "model_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "elapsed_seconds": {
            "type": "number",
            "minimum": 0
          },
          "usage": {
            "type": [
              "object",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "record": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "role",
          "model",
          "elapsed_seconds",
          "usage",
          "status",
          "record"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "caller_costs": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "1.0"
            },
            "delivery_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "revision_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "human_minutes": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "compute_cost": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "currency": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "schema_version",
            "delivery_id",
            "revision_id",
            "human_minutes",
            "compute_cost",
            "currency",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "limitation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "schema_version",
    "elapsed_seconds",
    "model_calls",
    "caller_costs",
    "limitation"
  ],
  "additionalProperties": false
}
