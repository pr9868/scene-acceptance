          "item_id",
          "statement",
          "producer_decision",
          "original_status",
          "required",
          "model_recommendation",
          "policy_outcome",
          "policy_reasons",
          "policy_rule",
          "missing_evidence_ids",
          "original_review",
          "human_review",
          "review_risk",
          "review_risk_basis",
          "review_risk_reason"
