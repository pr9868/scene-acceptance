{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "kind": {
      "const": "assumption-triage"
    },
    "decision": {
      "enum": [
        "NO_ADDITIONAL_REVIEW",
        "NEEDS_REVIEW",
        "REJECT",
        "EVALUATION_ERROR"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        2,
        3,
        4
      ]
    },
    "next_action": {
      "enum": [
        "none",
        "review_specification",
        "review_finding",
        "provide_evidence",
        "repair_scene",
        "fix_environment"
      ]
    },
    "execution_status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "assessment_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "original_core_verdict": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "original_scope_verdict": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
