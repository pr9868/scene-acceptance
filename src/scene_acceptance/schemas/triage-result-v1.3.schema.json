                  "item_id",
                  "status",
                  "reviewer",
                  "reason",
                  "evidence"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "human_review": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "item_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*$"
                  },
                  "status": {
                    "enum": [
                      "approved",
                      "rejected",
                      "needs_review"
                    ]
                  },
                  "reviewer": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "path",
                        "sha256"
