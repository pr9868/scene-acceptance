{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "delivery_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "human_minutes": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "compute_cost": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "schema_version",
    "delivery_id",
    "revision_id",
    "human_minutes",
    "compute_cost",
    "currency",
    "source"
  ],
  "additionalProperties": false
}
