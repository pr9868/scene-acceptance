{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "possible_consequence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "prim_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true
          },
          "needed_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 256
          }
        },
        "required": [
          "id",
          "question",
          "possible_consequence",
          "evidence_ids",
          "prim_paths",
          "needed_evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 32
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "maxItems": 256
    }
  },
  "required": [
    "schema_version",
    "request_sha256",
    "questions",
    "limitations"
  ],
  "additionalProperties": false
}
