{
  "type": "object",
  "properties": {
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "assessment": {
            "enum": [
              "consistent",
              "concern",
              "unknown"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 256
          }
        },
        "required": [
          "requirement_id",
          "assessment",
          "explanation",
          "evidence_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "maxItems": 256
    }
  },
  "required": [
    "request_sha256",
    "items",
    "limitations"
  ],
  "additionalProperties": false
}
