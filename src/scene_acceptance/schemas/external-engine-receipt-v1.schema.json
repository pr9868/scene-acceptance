{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scene_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "engine": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "environment_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "name",
        "version",
        "environment_sha256"
      ],
      "additionalProperties": false
    },
    "provider": {
      "enum": [
        "simready",
        "physx",
        "other"
      ]
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "execution_status": {
      "enum": [
        "completed",
        "failed",
        "partial"
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "enum": [
              "profile",
              "runtime"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "ERROR",
              "SKIPPED"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "phase",
          "status",
          "reason",
          "evidence_paths"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 256
    }
  },
  "required": [
    "schema_version",
    "scene_sha256",
    "engine",
    "provider",
    "profile_id",
    "profile_sha256",
    "execution_status",
    "tests",
    "attachments",
    "producer",
    "limitations"
  ],
  "additionalProperties": false
}
