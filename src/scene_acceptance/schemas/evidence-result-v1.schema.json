{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scene_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capture_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 256
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 256
          },
          "times_seconds": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 0,
            "maxItems": 256
          },
          "status": {
            "enum": [
              "supplied",
              "missing",
              "invalid"
            ]
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 256
          },
          "view_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 256
          },
          "view_role": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "camera_guidance": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "camera_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "projection": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "sharing_group": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "eligible_view_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 256
          },
          "caller_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "request_id",
          "requirement_ids",
          "purpose",
          "targets",
          "times_seconds",
          "status",
          "gaps",
          "view_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "evidence_policy": {
      "type": "object"
    },
    "model_calls": {
      "const": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "execution_status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        3,
        4
      ]
    }
  },
  "required": [
    "schema_version",
    "plan_sha256",
    "scene_sha256",
    "capture_requests",
    "evidence_policy",
    "model_calls",
    "errors",
    "execution_status",
    "exit_code"
  ],
  "additionalProperties": false
}
