{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "intended_use": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "artifact_format": {
      "const": "usd-local-v1"
    },
    "allowed_dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "packs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "version"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "pack": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "check": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "required": {
            "type": "boolean"
          },
          "parameters": {
            "type": "object"
          },
          "after": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "uniqueItems": true
          },
          "specification_source": {
            "type": "object",
            "properties": {
              "provided_by": {
                "enum": [
                  "human",
                  "application",
                  "agent",
                  "preset",
                  "unrecorded"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "provided_by",
              "reference"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "pack",
          "check",
          "required",
          "parameters"
        ],
        "additionalProperties": false
      }
    },
    "report_context": {
      "type": "object",
      "properties": {
        "scene_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "intended_use",
    "profile",
    "artifact_format",
    "allowed_dependencies",
    "evidence_sources",
    "packs",
    "checks"
  ],
  "additionalProperties": false
}
