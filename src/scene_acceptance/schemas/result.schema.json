{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "checker_version": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "ACCEPT_FOR_USE",
        "REJECT",
        "INSUFFICIENT_EVIDENCE",
        "EVALUATION_ERROR"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "intended_use": {
      "type": [
        "string",
        "null"
      ]
    },
    "contract_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity": {
      "type": "object"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "ERROR",
              "NOT_APPLICABLE"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {},
          "duration_ms": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "required",
          "status",
          "reason",
          "evidence",
          "duration_ms"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object"
    },
    "runtime": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "checker_version",
    "verdict",
    "complete",
    "intended_use",
    "contract_id",
    "identity",
    "checks",
    "coverage",
    "runtime"
  ],
  "additionalProperties": false
}
