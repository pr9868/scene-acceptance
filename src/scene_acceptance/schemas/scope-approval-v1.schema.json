{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scope_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "approved",
        "rejected",
        "needs_review"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "schema_version",
    "scope_sha256",
    "status",
    "reviewer",
    "reason",
    "created_at_utc"
  ],
  "additionalProperties": false
}
